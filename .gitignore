# =============================================================================
# Unreal Engine Project .gitignore
# Each recipe is an Unreal project in its own top-level folder, so project
# level paths are anchored as /*/<name>/ to avoid catching Content or Source
# folders that happen to share a name.
# =============================================================================

# ----- Unreal Engine Generated Directories ----------------------------------
# Unanchored on purpose: these also cover Plugins/**/Binaries and Intermediate.
Binaries/
DerivedDataCache/
Intermediate/
Saved/
/*/Build/

# ----- Unreal Engine Generated Files ----------------------------------------
*.VC.db
*.opensdf
*.opendb
*.sdf
*.suo
*.user
*.dbmdl
*.log

# ----- Visual Studio --------------------------------------------------------
.vs/
.vsconfig
*.sln
*.slnx
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
UpgradeLog.htm

# ----- Visual Studio Code ---------------------------------------------------
.vscode/
*.code-workspace

# ----- JetBrains Rider ------------------------------------------------------
.idea/
*.DotSettings.user

# ----- Xcode ----------------------------------------------------------------
*.xcworkspace
*.xcodeproj

# ----- Compiled Source ------------------------------------------------------
# If a recipe vendors third-party libraries, add an exception such as
# !*/Source/ThirdParty/**/*.lib
*.obj
*.pch
*.ilk
*.exp
*.lib
*.pdb
*.idb

# ----- Packaging / Distribution ---------------------------------------------
/*/Releases/
/*/Packages/
*.pak
*.ucas
*.utoc
*.sig

# ----- Shader Cache ---------------------------------------------------------
/*/ShaderCache/

# ----- OS Artefacts ---------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ----- Miscellaneous --------------------------------------------------------
*.bak
*.tmp
*.temp
*~

# ----- Unreal MCP reference (generated per machine by Generate-MCPReference.ps1)
mcp_reference/

# ----- AI assistant files ---------------------------------------------------
CLAUDE.md
.claude/
.remember/
docs/
.mcp.json
Gameplay/AGENTS.md
