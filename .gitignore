*.vc.db
*.opensdf
*.opendb
*.sdf
*.suo
*.user
*.dbmdl
*.log

# ----- Visual Studio --------------------------------------------------------
.vs/
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
ipch/
x64/
x86/
Debug/
Release/
UpgradeLog.htm

# ----- JetBrains Rider ------------------------------------------------------
.idea/
*.DotSettings.user

# ----- Compiled Source ------------------------------------------------------
*.obj
*.pch
*.ilk
*.exp
*.lib
*.pdb
*.idb

# ----- Plugins (third-party; keep your own source) --------------------------
